% Bibliography for the non-LTE abundance-correction grids used by this project.
%
% AAS/ADS style: citation keys are ADS bibcodes and journal names use the
% AASTeX macros (\aap, \mnras, \araa, \ssr), so these entries drop straight
% into an AASTeX or A&A manuscript. Every field was taken from the publisher's
% Crossref record rather than transcribed by hand; the bibcodes are constructed
% from that metadata and checked against the two the grid files state directly
% (Matsuno 2024 and Caliskan 2025, recorded in their VizieR headers).
%
% Each entry is annotated with the source ids it covers; `nlte.sources()` and
% docs/line_coverage.md name the same ids.

% amarsi2020_* -- 22 CSV grids: Li, C, O, Na, Mg, Al, Si, K, Ca, Mn, Ba,
% with and without coherent scattering
@ARTICLE{2020A&A...642A..62A,
       author = {{Amarsi}, A. M. and {Lind}, K. and {Osorio}, Y. and {Nordlander}, T. and {Bergemann}, M. and {Reggiani}, H. and {Wang}, E. X. and {Buder}, S. and {Asplund}, M. and {Barklem}, P. S. and {Wehrhahn}, A. and {Skúladóttir}, Á. and {Kobayashi}, C. and {Karakas}, A. I. and {Gao}, X. D. and {Bland-Hawthorn}, J. and {De Silva}, G. M. and {Kos}, J. and {Lewis}, G. F. and {Martell}, S. L. and {Sharma}, S. and {Simpson}, J. D. and {Zucker}, D. B. and {Čotar}, K. and {Horner}, J. and {the GALAH Collaboration}},
        title = "{The GALAH Survey: non-LTE departure coefficients for large spectroscopic surveys}",
      journal = {\aap},
         year = 2020,
       volume = {642},
        pages = {A62},
          doi = {10.1051/0004-6361/202038650},
}

