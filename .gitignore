__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# Parsed-grid caches, rebuilt on demand.
.cache/

# Grid data is large (>500 MB) and redistributed by its original authors;
# only the manifests describing it are tracked.
grids/**
!grids/**/
!grids/**/*.toml
# The Amarsi 2022 iron networks are small and MIT-licensed, so this one grid is
# vendored rather than downloaded. Only the extracted weights, the line list and
# the licence are tracked -- not the upstream pickles, which execute code on load
# and are reproducible with tools/vendor_amarsi2022_fe.py.
!grids/amarsi2022_fe/*.npz
!grids/amarsi2022_fe/fe_lines.csv
!grids/amarsi2022_fe/LICENSE
!grids/amarsi2022_fe/PROVENANCE.md

# Local Claude Code settings.
.claude/settings.local.json

# Generated outputs from example runs, including the _std companion that
# nlte-correct writes beside each output.
teste_interpolador_out.csv
teste_interpolador_out_std.csv
teste_interpolador_wide.csv
teste_interpolador_wide_std.csv
